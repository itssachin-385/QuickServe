# QuickServe Environment Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgres://quickserve:quickserve_secret@localhost:5432/quickserve_db

# JWT & Authentication
JWT_SECRET=quickserve_jwt_secret_production_key_2026

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_live_sample_key
RAZORPAY_KEY_SECRET=sample_secret_key

# SMS & OTP Gateway (Fast2SMS / MSG91)
SMS_AUTH_KEY=sample_msg91_auth_key

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=quickserve-india
